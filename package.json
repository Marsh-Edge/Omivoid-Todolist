{
  "name": "omivoid-todolist",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Todo / task-management app (Next.js static export + Dexie + Electron).",
  "license": "MIT",
  "author": "Edge Quantum",
  "homepage": "https://github.com/Marsh-Edge/Omivoid-Todolist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marsh-Edge/Omivoid-Todolist.git"
  },
  "bugs": {
    "url": "https://github.com/Marsh-Edge/Omivoid-Todolist/issues"
  },
  "keywords": [
    "todo",
    "task-manager",
    "local-first",
    "offline-first",
    "privacy",
    "productivity",
    "electron",
    "nextjs",
    "dexie"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "electron/out/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "seed": "node scripts/seed.mjs",
    "serve": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "electron:dev": "next build && tsc -p electron/tsconfig.json && electron .",
    "electron:build": "next build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:win": "next build && tsc -p electron/tsconfig.json && electron-builder --win --publish never",
    "electron:build:linux": "next build && tsc -p electron/tsconfig.json && electron-builder --linux AppImage --publish never",
    "release:checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
